rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users can only read/write their own user document
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      // Users can manage their own connected repos
      match /repos/{repoId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Repo data: only users who have connected the repo can access it
    // In production, you'd cross-reference users/{uid}/repos/{repoId}
    // For hackathon, we allow authenticated users to read/write repo data
    match /repos/{repoId} {
      allow read, write: if request.auth != null;

      match /pr_reviews/{prNumber} {
        allow read, write: if request.auth != null;
      }

      match /docs/{docId} {
        allow read, write: if request.auth != null;
      }

      match /triage/{issueNumber} {
        allow read, write: if request.auth != null;
      }

      match /tests/{testId} {
        allow read, write: if request.auth != null;
      }

      match /health_reports/{reportId} {
        allow read, write: if request.auth != null;
      }
    }
  }
}
