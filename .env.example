# ============================================================
# CodeSentinel — Environment Variables
# ============================================================
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_API_KEY=your-firebase-api-key
FIREBASE_AUTH_DOMAIN=your-firebase-project-id.firebaseapp.com
FIREBASE_STORAGE_BUCKET=your-firebase-project-id.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
FIREBASE_APP_ID=your-app-id
FIREBASE_ADMIN_SDK_JSON_PATH=/app/firebase-service-account.json
FIREBASE_RTDB_URL=https://your-firebase-project-id-default-rtdb.firebaseio.com/

GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

NVIDIA_API_KEY=your-nvidia-nim-api-key
GEMINI_API_KEY=your-gemini-api-key
GROQ_API_KEY=your-groq-api-key

DJANGO_SECRET_KEY=your-django-secret-key-change-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*

# Generate a 32-byte url-safe base64 string for this
FIELD_ENCRYPTION_KEY=your-base64-encryption-key=

REDIS_URL=redis://redis:6379/0

VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-firebase-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-firebase-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-app-id
VITE_FIREBASE_RTDB_URL=https://your-firebase-project-id-default-rtdb.firebaseio.com/
VITE_API_BASE_URL=http://localhost:8000/api
VITE_GITHUB_CLIENT_ID=your-github-client-id
